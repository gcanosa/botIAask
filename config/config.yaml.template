irc:
    # Multiple networks are supported: add another '- name: ...' entry to connect to more
    # than one IRC server/network at the same time. (A legacy flat single-network shape —
    # server:/port:/... directly under `irc:`, no `networks:` list — is still accepted on
    # read for old config files, but is always rewritten to this shape on save.)
    networks:
        - name: libera
          server: irc.libera.chat
          port: 6697
          use_ssl: true
          # Skip TLS certificate verification (self-signed cert, or connecting by bare IP
          # with no matching SAN). Only relevant when use_ssl is true. Leave off/false when
          # the server has a proper cert.
          # tls_skip_verify: true
          nickname: Nickname
          # Channels: plain strings, or a mapping for +k. Optional: auto_join: false (default true) to store the row without auto-joining.
          #   - name: '##locked'
          #     password: 'channel-key-here'
          #   - { name: '##nope', auto_join: false }
          channels:
              - '#channel1'
              - '#channel2'
          # QUIT message: omit (or use "") for default: "<app name> <version> Uptime: <uptime>".
          # Or a custom string; use {name} {version} {uptime} {nickname} for dynamic parts.
          # quit_message: '{name} v{version} | Up: {uptime}'
          services:
              enabled: true
              username: registered_nickname
              password: services_password
        # Second network example (delete or uncomment/edit as needed):
        # - name: OtherNet
        #   server: irc.example.org
        #   port: 6697
        #   use_ssl: true
        #   # Needed when connecting by bare IP or to a self-signed cert (no matching SAN):
        #   tls_skip_verify: true
        #   nickname: Nickname
        #   channels:
        #       - '#otherchannel'
        #   services:
        #       enabled: false
ai:
    lm_studio_url: http://localhost:1234/v1
    model: meta-Llama-3.1-8B-instruct
bot:
    command_prefix: '!'
    command_name: ask
    debug: true
    rate_limiting:
        enabled: true
        limit: 3
        burst: 2
        window: 60
admin:
    admins:
        # Use hostmask format: ~nickname@user/host-ip (editable from web Identity panel or here)
        - ~nickname@user/host-ip
web:
    enabled: true
    port: 3366
    host: 0.0.0.0
    base_url: http://sekurnet.duckdns.org:3366
    # Dashboard "server location" weather (Open-Meteo geocoding + forecast)
    server_location: 'Barcelona, Spain'
    # How often the web panel fetches /api/weather and server cache window (minutes)
    weather_refresh_minutes: 30
    auth:
        enabled: false
        username: admin
        password: password
daemon:
    enabled: true
    pid_file: bot.pid
logger:
    rotation_days: 7
rss:
    enabled: true
    interval_minutes: 30
    # Each entry is "network:#channel" to target a specific network, or a bare "#channel"
    # to fall back to the first network in irc.networks (back-compat, single-network configs).
    # Mix networks freely to fan the same feeds out to channels on different networks.
    channels:
        - 'libera:##yerba'
        # - 'OtherNet:#otherchannel'
    # Max rows kept per feed source in the news DB (not a single global cap across all feeds).
    retention_count: 50
    # Each feed URL is labeled in IRC and on the web from the site (e.g. arstechnica.com → [ARSTECHNICA]).
    feed_urls:
        - https://news.ycombinator.com/rss
    announce_to_irc: true
stats:
    enabled: true
    interval: 60
    save_to_db: true
    retention_days: 7
uploads:
    max_file_mb: 200
# OMDb for !movie (year, IMDb rating, short plot). Key: https://www.omdbapi.com/apikey.aspx
# omdb:
#     api_key: your_omdb_key
#     # base_url: https://www.omdbapi.com/

# GitHub for changelog (fetches commits from remote repository instead of local git).
# Useful for Docker/pod deployments where git history is not available locally.
# Set token for higher API rate limits (60 req/hr unauthenticated, 5000 req/hr authenticated).
# Get a token at https://github.com/settings/tokens (needs public_repo scope at minimum).
# github:
#     owner: your-github-username-or-org
#     repo: repository-name
#     token: ghp_xxxxx  # Optional; also reads GITHUB_TOKEN env var
#     ref: main  # Optional; defaults to "main" if omitted

# Scheduled SQLite hot backups (VACUUM INTO data/backups/). Enabled by default.
# backup:
#     enabled: true          # set false to disable
#     interval_hours: 24     # how often to snapshot (default 24)
#     keep: 7                # snapshots to retain per database (default 7)
